<Window x:Class="Pinwi.Pos.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Helados Pinwi Pinwi · Punto de venta" Width="1366" Height="800" MinWidth="1050" MinHeight="650" Background="#F6F5FA" FontFamily="Segoe UI" Loaded="LoadedWindow">
<DockPanel Margin="20">
<Grid DockPanel.Dock="Top" Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Image x:Name="BrandLogo" Width="66" Height="66" Margin="0,0,14,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="Pinwi Pinwi" FontSize="26" FontWeight="Bold" Foreground="#25233D"/><TextBlock Text="HECHO PARA DISFRUTAR · PUNTO DE VENTA" FontSize="10" Foreground="#807991" Margin="0,4,0,0"/></StackPanel></StackPanel><TextBlock Grid.Column="1" Text="●  Sin conexión necesaria" VerticalAlignment="Center" Foreground="#D73680"/></Grid>
<TextBlock x:Name="Status" DockPanel.Dock="Bottom" Margin="8" Foreground="#475569"/>
<TabControl Background="#F6F5FA" BorderThickness="0">
<TabItem Header="  Venta  "><Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="430"/></Grid.ColumnDefinitions>
<DockPanel Margin="0,0,20,0">
<StackPanel DockPanel.Dock="Top" Margin="0,0,0,16"><TextBlock Text="¿Qué se te antoja hoy?" FontSize="28" FontWeight="SemiBold" Foreground="#25233D"/><TextBlock Text="Elige un tipo de producto y después un sabor." Foreground="#64748B" Margin="0,6,0,14"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="HomeButton" Content="Inicio" Click="BackCategories"/><TextBox Grid.Column="1" x:Name="Search" TextChanged="SearchChanged" ToolTip="Buscar sabor"/></Grid><ComboBox x:Name="Categories" Visibility="Collapsed" SelectionChanged="SearchChanged"/><TextBlock x:Name="CatalogHeading" Margin="4,12,0,0" FontSize="18" FontWeight="SemiBold"/></StackPanel>
<ScrollViewer VerticalScrollBarVisibility="Auto"><Grid>
<ItemsControl x:Name="CategoryList"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Width="218" Height="220" Click="EnterCategory" Tag="{Binding Family}" Background="White" Padding="10"><StackPanel><Border CornerRadius="14" Background="#F6F5FA"><Image Source="{Binding CategoryImagePath}" Height="140" Stretch="Uniform"/></Border><TextBlock Text="{Binding Family}" FontSize="17" FontWeight="SemiBold" Margin="4,14,0,0"/><TextBlock Text="Explorar sabores →" Foreground="#64748B" FontSize="12" Margin="4,4"/></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
<ItemsControl x:Name="ProductList" Visibility="Collapsed"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Width="205" Height="264" Click="AddProduct" Tag="{Binding}" Background="White" Padding="12"><StackPanel><Image Source="{Binding ImagePath}" Height="130" Stretch="Uniform"/><TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,4"/><TextBlock Text="{Binding Category}" Foreground="#64748B" FontSize="11"/><TextBlock Text="{Binding RetailPesos,StringFormat=C}" FontSize="21" FontWeight="Bold" Foreground="#D73680"/><TextBlock Text="{Binding WholesalePesos,StringFormat='Mayoreo {0:C}'}" Foreground="#64748B" FontSize="12"/><TextBlock Text="{Binding StockWarning}" Foreground="#C43E5A" FontSize="11"/></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
</Grid></ScrollViewer></DockPanel>
<Border Grid.Column="1" Background="White" CornerRadius="22" Padding="18"><DockPanel>
<StackPanel DockPanel.Dock="Bottom"><Border Height="1" Background="#E6ECEB" Margin="0,12"/><TextBlock Text="{Binding Savings}" FontSize="12" Foreground="#64748B" TextWrapping="Wrap"/><Grid Margin="0,8"><TextBlock Text="Total" FontSize="18" VerticalAlignment="Center"/><TextBlock Text="{Binding Total}" FontSize="36" FontWeight="Bold" HorizontalAlignment="Right" Foreground="#D73680"/></Grid><WrapPanel><Button Content="Vaciar venta" Click="ClearCart"/><Button Content="Descuento %" Click="SetDiscount"/></WrapPanel><Button Content="Cobrar →" Click="Pay" Background="#D73680" Foreground="White" FontWeight="SemiBold" FontSize="19" Height="58" Margin="0,14,0,0"/></StackPanel>
<StackPanel DockPanel.Dock="Top"><TextBlock Text="Tu venta" FontSize="26" FontWeight="SemiBold"/><TextBlock x:Name="DraftState" Text="Guardado automático activo" Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/><TextBlock Text="Ajusta piezas aquí · Mayoreo automático" Foreground="#64748B" Margin="0,6,0,10"/></StackPanel>
<ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="CartGrid" ItemsSource="{Binding Lines}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#E6ECEB" BorderThickness="0,0,0,1" Padding="0,8"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition/></Grid.ColumnDefinitions><Border CornerRadius="10" Background="#F6F5FA" Margin="0,0,10,0"><Image Source="{Binding ImagePath}" Width="48" Height="48" Stretch="Uniform"/></Border><TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" VerticalAlignment="Center"/></Grid><TextBlock Text="{Binding StockWarning}" Foreground="#C43E5A" FontSize="11" TextWrapping="Wrap"/><Grid Margin="0,5"><StackPanel><TextBlock Text="{Binding Mode}" Foreground="#D73680" FontSize="12"/><TextBlock Text="{Binding Price,StringFormat='Precio {0:C}'}" Foreground="#64748B" FontSize="12"/></StackPanel><TextBlock Text="{Binding Total,StringFormat=C}" HorizontalAlignment="Right" FontSize="18" FontWeight="SemiBold"/></Grid><StackPanel Orientation="Horizontal"><Button Content="−" Tag="{Binding ProductId}" Click="DecreaseQuantity" Width="42" Padding="0" Height="36"/><TextBox Text="{Binding Quantity,Mode=OneWay}" Tag="{Binding ProductId}" Width="72" Height="38" Padding="4" TextAlignment="Center" TextChanged="QuantityTyping" LostKeyboardFocus="QuantityEdited" KeyDown="QuantityKeyDown" ToolTip="Escribe la cantidad y pulsa Enter. Cero elimina el producto."/><Button Content="+" Tag="{Binding ProductId}" Click="IncreaseQuantity" Width="42" Padding="0" Height="36"/><Button Content="Quitar" Tag="{Binding ProductId}" Click="DeleteLine" FontSize="12" Background="Transparent" Foreground="#BE4563"/></StackPanel></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
</DockPanel></Border>
</Grid></TabItem>
<TabItem Header="  Productos y precios  "><DockPanel Margin="16"><Button DockPanel.Dock="Top" Content="Editar precios del producto" Click="EditProduct" HorizontalAlignment="Left"/><DataGrid x:Name="Inventory"><DataGrid.Columns><DataGridTextColumn Header="Código" Binding="{Binding Id}"/><DataGridTextColumn Header="Categoría" Binding="{Binding Category}" Width="*"/><DataGridTextColumn Header="Sabor" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Menudeo" Binding="{Binding RetailPesos,StringFormat=C}"/><DataGridTextColumn Header="Mayoreo" Binding="{Binding WholesalePesos,StringFormat=C}"/></DataGrid.Columns></DataGrid></DockPanel></TabItem>
<TabItem Header="  Caja  "><DockPanel Margin="24"><StackPanel DockPanel.Dock="Top"><TextBlock Text="Caja, cortes y gastos" FontSize="26" FontWeight="SemiBold"/><WrapPanel Margin="0,10"><TextBlock x:Name="ShiftLabel" Margin="8" FontSize="16" VerticalAlignment="Center"/><Button Content="Abrir caja" Click="OpenCash"/><Button Content="Cerrar caja y registrar conteo" Click="CloseCash"/><Button Content="Registrar gastos" Click="RegisterExpense" Background="#D73680" Foreground="White"/></WrapPanel><CheckBox x:Name="AutoWhatsApp" IsChecked="True" Content="Abrir WhatsApp con la nota al cerrar caja" Margin="8"/><TextBlock x:Name="CutDelivery" Text="El envío requiere internet y pulsar Enviar en WhatsApp. La nota incluye ventas, gastos y resultado del día." Foreground="#707084" TextWrapping="Wrap" Margin="8"/></StackPanel>
<TabControl x:Name="CashViews" BorderThickness="0" Background="Transparent"><TabItem Header="Cortes"><DockPanel><WrapPanel DockPanel.Dock="Top"><Button Content="Enviar por WhatsApp" Click="SendCutWhatsApp"/><Button Content="Abrir nota y CSV del corte" Click="OpenCutFolder"/><Button Content="Marcar como enviado" Click="MarkCutSent"/></WrapPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions><DataGrid x:Name="CutsGrid" SelectionChanged="ShowCut" SelectionMode="Single"><DataGrid.Columns><DataGridTextColumn Header="Corte" Binding="{Binding Id}"/><DataGridTextColumn Header="Cierre" Binding="{Binding ClosedLabel}" Width="*"/><DataGridTextColumn Header="Usuario" Binding="{Binding Cashier}"/><DataGridTextColumn Header="Ventas" Binding="{Binding Total,StringFormat=C}"/><DataGridTextColumn Header="Gastos" Binding="{Binding ExpensesPesos,StringFormat=C}"/><DataGridTextColumn Header="Resultado" Binding="{Binding NetAfterExpenses,StringFormat=C}"/><DataGridTextColumn Header="Contado" Binding="{Binding CountedPesos,StringFormat=C}"/><DataGridTextColumn Header="Diferencia" Binding="{Binding Difference,StringFormat=C}"/></DataGrid.Columns></DataGrid><TextBox Grid.Column="1" x:Name="CutSummary" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="16,4,0,0"/></Grid></DockPanel></TabItem>
<TabItem Header="Gastos del día"><DockPanel Margin="4"><TextBlock x:Name="DailyExpensesLabel" DockPanel.Dock="Top" FontSize="18" FontWeight="SemiBold" Margin="8,14"/><TextBlock DockPanel.Dock="Bottom" Text="Los gastos se conservan en el historial. Solo el efectivo de caja modifica el conteo esperado." Foreground="#707084" Margin="8" TextWrapping="Wrap"/><DataGrid x:Name="ExpensesGrid"><DataGrid.Columns><DataGridTextColumn Header="Folio" Binding="{Binding Id}"/><DataGridTextColumn Header="Fecha" Binding="{Binding DateLabel}" Width="145"/><DataGridTextColumn Header="Concepto" Binding="{Binding Concept}" Width="*"/><DataGridTextColumn Header="Proveedor / persona" Binding="{Binding Recipient}" Width="180"/><DataGridTextColumn Header="Importe" Binding="{Binding Pesos,StringFormat=C}"/><DataGridTextColumn Header="Origen" Binding="{Binding SourceLabel}" Width="130"/><DataGridTextColumn Header="Registró" Binding="{Binding Cashier}" Width="120"/></DataGrid.Columns></DataGrid></DockPanel></TabItem></TabControl>
</DockPanel></TabItem>
<TabItem Header="  Historial y reportes  "><DockPanel Margin="16"><WrapPanel DockPanel.Dock="Top"><Button Content="Actualizar" Click="RefreshHistory"/><Button Content="Ver ticket / reimprimir" Click="ViewReceipt"/><Button Content="Exportar CSV" Click="Export"/></WrapPanel><TextBlock x:Name="SalesTotal" DockPanel.Dock="Bottom" FontSize="18" Margin="12"/><DataGrid x:Name="History"><DataGrid.Columns><DataGridTextColumn Header="Folio" Binding="{Binding Folio}"/><DataGridTextColumn Header="Fecha" Binding="{Binding Date}" Width="*"/><DataGridTextColumn Header="Usuario" Binding="{Binding Cashier}" Width="160"/><DataGridTextColumn Header="Total" Binding="{Binding Total,StringFormat=C}"/><DataGridTextColumn Header="Efectivo neto" Binding="{Binding Cash,StringFormat=C}"/><DataGridTextColumn Header="Tarjeta" Binding="{Binding Card,StringFormat=C}"/></DataGrid.Columns></DataGrid></DockPanel></TabItem>
<TabItem Header="  Respaldo  "><StackPanel Margin="30" HorizontalAlignment="Left"><TextBlock Text="Protege tus ventas" FontSize="26"/><TextBlock x:Name="BackupState" Text="Respaldo automático cada 5 minutos y después de cambios" TextWrapping="Wrap" Margin="8,16"/><TextBlock Text="El carrito se guarda al modificarlo. Las copias automáticas conservan hasta 288 versiones locales." TextWrapping="Wrap" Margin="8"/><TextBlock Text="Genera una copia consistente de la base local en una carpeta o USB." Margin="8,20"/><Button Content="Crear respaldo" Click="Backup"/></StackPanel></TabItem>
</TabControl></DockPanel></Window>
