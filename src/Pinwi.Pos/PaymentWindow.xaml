<Window x:Class="Pinwi.Pos.PaymentWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Cobrar venta" Width="900" Height="710" MinWidth="800" MinHeight="650" WindowStartupLocation="CenterOwner" Background="#F6F5FA" FontFamily="Segoe UI" ResizeMode="CanResize">
<Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel Margin="0,0,0,24"><TextBlock Text="Completa tu venta" FontSize="30" FontWeight="Bold" Foreground="#222238"/><TextBlock Text="Elige cómo paga el cliente y revisa su cambio antes de cobrar." Foreground="#707084" Margin="0,6,0,0"/></StackPanel>
<Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
<ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,24,0">
<TextBlock Text="Método de pago" FontSize="15" FontWeight="SemiBold"/><UniformGrid Columns="3" Margin="0,10,0,20"><Button x:Name="CashMethod" Content="Efectivo" Tag="cash" Click="SelectMethod"/><Button x:Name="CardMethod" Content="Tarjeta" Tag="card" Click="SelectMethod"/><Button x:Name="MixedMethod" Content="Mixto" Tag="mixed" Click="SelectMethod"/></UniformGrid>
<StackPanel x:Name="CardPanel" Visibility="Collapsed"><TextBlock Text="Importe en terminal externa" FontWeight="SemiBold"/><TextBox x:Name="CardInput" Text="0" TextChanged="AmountsChanged" FontSize="24"/><CheckBox x:Name="Authorized" Content="La terminal ya autorizó este pago" Margin="4,8,4,18" Checked="AuthorizationChanged" Unchecked="AuthorizationChanged"/></StackPanel>
<StackPanel x:Name="CashPanel"><TextBlock Text="¿Con cuánto paga el cliente?" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Selecciona un importe o escríbelo manualmente en pesos." Foreground="#707084" Margin="0,7,0,14" TextWrapping="Wrap"/><TextBox x:Name="CashInput" FontSize="32" TextChanged="AmountsChanged" ToolTip="Efectivo recibido del cliente"/><WrapPanel x:Name="Suggested" Margin="0,10,0,18"/></StackPanel>
<TextBlock x:Name="Validation" Foreground="#C43E5A" FontWeight="SemiBold" TextWrapping="Wrap" Margin="4,8"/>
<TextBlock x:Name="StockWarning" Foreground="#C43E5A" TextWrapping="Wrap" Margin="4,8"/>
</StackPanel></ScrollViewer>
<Border Grid.Column="1" Background="#25233D" CornerRadius="22" Padding="24"><StackPanel><TextBlock Text="TOTAL A COBRAR" Foreground="#C9C5E2" FontSize="12"/><TextBlock x:Name="TotalLabel" Foreground="White" FontSize="38" FontWeight="Bold" Margin="0,12,0,28"/><Border Height="1" Background="#49465F"/><TextBlock Text="CAMBIO A ENTREGAR" Foreground="#C9C5E2" FontSize="12" Margin="0,28,0,8"/><TextBlock x:Name="ChangeLabel" Foreground="#8EF0C8" FontSize="42" FontWeight="Bold"/><TextBlock x:Name="PaymentHint" Foreground="White" TextWrapping="Wrap" FontSize="16" Margin="0,10,0,0"/><TextBlock Text="Confirma siempre el dinero recibido antes de entregar el cambio." Foreground="#C9C5E2" FontSize="12" TextWrapping="Wrap" Margin="0,32,0,0"/></StackPanel></Border>
</Grid>
<Grid Grid.Row="2" Margin="0,24,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="Volver a la venta" Click="Cancel" HorizontalAlignment="Left"/><Button x:Name="Confirm" Grid.Column="1" Content="Confirmar cobro →" Background="#D73680" Foreground="White" Height="56" FontSize="18" FontWeight="SemiBold" Click="ConfirmPayment" IsEnabled="False"/></Grid>
</Grid></Window>
