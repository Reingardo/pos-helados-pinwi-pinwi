<Window x:Class="Pinwi.Pos.ExpenseWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Registrar gastos" Width="560" Height="680" MinHeight="580" WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Background="#F6F5FA" FontFamily="Segoe UI">
<ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28"><TextBlock Text="Registrar gasto" FontSize="28" FontWeight="Bold" Foreground="#25233D"/><TextBlock Text="Se incluirá en el corte del día y en el resumen para WhatsApp." TextWrapping="Wrap" Foreground="#707084" Margin="0,8,0,22"/>
<TextBlock Text="Importe en pesos" FontWeight="SemiBold"/><TextBox x:Name="AmountInput" FontSize="28"/>
<TextBlock Text="Concepto del gasto" FontWeight="SemiBold" Margin="4,12,0,0"/><TextBox x:Name="ConceptInput" MaxLength="240" ToolTip="Ej. Compra de vasos, pago de proveedor o salario"/>
<TextBlock Text="Proveedor o persona (opcional)" FontWeight="SemiBold" Margin="4,12,0,0"/><TextBox x:Name="RecipientInput" MaxLength="120"/>
<TextBlock Text="¿De dónde salió el dinero?" FontWeight="SemiBold" Margin="4,12,0,0"/><ComboBox x:Name="SourceInput" SelectedIndex="0" Margin="4,8" Padding="12"><ComboBoxItem Content="Efectivo de esta caja"/><ComboBoxItem Content="Pago externo / transferencia"/></ComboBox>
<TextBlock Text="Solo los gastos pagados con efectivo de caja reducen el efectivo esperado. Todos se descuentan del resultado del día." Foreground="#707084" FontSize="12" TextWrapping="Wrap" Margin="4,8"/>
<TextBlock x:Name="Validation" Foreground="Crimson" TextWrapping="Wrap" Margin="4,8"/>
<Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="Cancelar" Click="Cancel"/><Button x:Name="Save" Grid.Column="1" Content="Guardar gasto" Click="SaveExpense" Background="#D73680" Foreground="White"/></Grid>
</StackPanel></ScrollViewer></Window>
